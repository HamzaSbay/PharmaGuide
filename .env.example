# ==============================================================================
# PharmaGuide TN — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or pass these parameters at runtime via `--dart-define`.
# When these parameters are omitted, PharmaGuide automatically runs in Local /
# Offline Mock Mode with zero network dependencies (perfect for dev and demos).
# ==============================================================================

# Supabase Backend Configuration (PostgreSQL + PostGIS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Firebase Cloud Messaging & Notifications (Optional)
FIREBASE_PROJECT_ID=pharmaguide-tn
FIREBASE_PROJECT_NUMBER=123456789012
FIREBASE_STORAGE_BUCKET=pharmaguide-tn.firebasestorage.app
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=1:123456789012:android:0000000000000000000000
FIREBASE_AUTH_DOMAIN=pharmaguide-tn.firebaseapp.com

# Example Running with Flutter CLI:
# flutter run --dart-define=SUPABASE_URL=https://xyz.supabase.co --dart-define=SUPABASE_ANON_KEY=sb_publishable_...
